local HVH = {
    Enabled = false,
    StompRunning = false,
    OriginalTarget = nil,
}
CombatAutoKill:AddToggle('HVHEnabled', {
    Text = "HVH",
    Default = false,
    Callback = function(Value)
        HVH.Enabled = Value
    end
})

local HVHConnection = nil

local function StartHVH()
    if HVHConnection then HVHConnection:Disconnect() end
    HVHConnection = RunService.Heartbeat:Connect(function()
        if not HVH.Enabled or not AutoKill.Enabled then return end
        if HVH.StompRunning then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        local healthPct = (hum.Health / hum.MaxHealth) * 100
        if healthPct > 70 then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local koTarget = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local tc = p.Character
                if tc then
                    local b = tc:FindFirstChild("BodyEffects")
                    local ko = b and b:FindFirstChild("K.O") and b["K.O"].Value
                    local dead = b and b:FindFirstChild("Dead") and b["Dead"].Value
                    local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("HumanoidRootPart")
                    if ko and not dead and ut then
                        koTarget = {player = p, part = ut}
                        break
                    end
                end
            end
        end
        if not koTarget then return end
        HVH.StompRunning = true
        HVH.OriginalTarget = AutoKill.Target
        local wasEnabled = AutoKill.Enabled
        AutoKill.CycleActive = false
        task.spawn(function()
            local me = getgenv().MainEvent or ReplicatedStorage:FindFirstChild("MainEvent")
            local returnCF = hrp.CFrame
            if hum then
                hum.Sit = false
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            for _ = 1, 15 do
                if not koTarget.part or not koTarget.part.Parent then break end
                hrp.CFrame = CFrame.new(koTarget.part.Position + Vector3.new(0, 3.5, 0))
                hrp.AssemblyLinearVelocity = Vector3.new()
                if me then pcall(function() me:FireServer("Stomp") end) end
                RunService.RenderStepped:Wait()
            end
            for _ = 1, 5 do
                if me then pcall(function() me:FireServer("Stomp") end) end
            end
            task.wait(0.1)
            hrp.CFrame = returnCF
            hrp.AssemblyLinearVelocity = Vector3.new()
            task.wait(0.15)
            if wasEnabled and AutoKill.Enabled then
                AutoKill.Target = HVH.OriginalTarget or AutoKill.GetNextValidTarget()
                AutoKill.CycleActive = false
                AutoKill.StartCycle()
            end
            HVH.StompRunning = false
        end)
    end)
end

local originalAutoKillCallback = Toggles.AutoKillEnabled and Toggles.AutoKillEnabled._Callback
Toggles.AutoKillEnabled:OnChanged(function()
    if Toggles.AutoKillEnabled.Value then
        StartHVH()
    else
        if HVHConnection then
            HVHConnection:Disconnect()
            HVHConnection = nil
        end
        HVH.StompRunning = false
    end
end)
